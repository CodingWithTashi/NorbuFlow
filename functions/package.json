{
  "name": "norbu-flow-functions",
  "description": "NorbuFlow backend: Cloud Functions for Firebase",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build && firebase emulators:exec --only auth,functions --project demo-norbu-flow \"vitest run --config vitest.e2e.config.mts\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "db:migrate": "npm run build && node --env-file-if-exists=.env lib/cli/db.js migrate",
    "db:staff": "npm run build && node --env-file-if-exists=.env lib/cli/db.js staff"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.0",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
